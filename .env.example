# Optional. When set, the AI Director uses Claude to storyboard videos.
# Without it, IntroMaker falls back to its built-in rule-based director.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
INTROMAKER_MODEL=
# Development only: allow importing websites on localhost/private networks.
INTROMAKER_ALLOW_PRIVATE_URLS=

# ── Hosting (see "Deploy (Docker)" in the README) ──
# Persistent folder for captured screenshots (the Docker image uses /data).
INTROMAKER_DATA_DIR=
# Days to keep captures / size cap in MB.
INTROMAKER_SHOT_TTL_DAYS=7
INTROMAKER_SHOT_MAX_MB=1024
# Headless browser sessions at once.
INTROMAKER_MAX_CAPTURES=2
# Trusted reverse proxies in front of the server (0 when it faces the internet directly).
INTROMAKER_PROXY_HOPS=1
# Rate limits are on in production; set to "off" to disable.
INTROMAKER_RATE_LIMIT=
# AI generations per day paid by ANTHROPIC_API_KEY, all visitors combined.
INTROMAKER_AI_DAILY_BUDGET=200
