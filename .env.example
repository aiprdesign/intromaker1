# ── Admin and payments (server environment only; never in a page or in git) ──
# Turns on the admin area at /admin and the video log; the password to sign in.
ADMIN_PASSWORD=
# The signing secret of your Stripe webhook endpoint (whsec_…), so payments switch plans on.
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Payment Links and portal from the environment (they win over Admin → Billing).
STRIPE_MONTHLY_LINK=
STRIPE_YEARLY_LINK=
STRIPE_PORTAL_LINK=
STRIPE_YEARLY_PRICE=

# Optional. When set, the AI Director uses Claude to storyboard videos.
# Without it, IntroMaker falls back to its built-in rule-based director.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
INTROMAKER_MODEL=
# Development only: allow importing websites on localhost/private networks.
INTROMAKER_ALLOW_PRIVATE_URLS=

# ── Hosting (see "Deploy (Docker)" in the README) ──
# The public address (https://…), for the sitemap, robots.txt and canonical links.
INTROMAKER_SITE_URL=
# Persistent folder for captured screenshots (the Docker image uses /data).
INTROMAKER_DATA_DIR=
# Days to keep captures / size cap in MB.
INTROMAKER_SHOT_TTL_DAYS=7
INTROMAKER_SHOT_MAX_MB=1024
# Headless browser sessions at once.
INTROMAKER_MAX_CAPTURES=2
# Seconds one capture may take before falling back to the HTML (15–120).
INTROMAKER_CAPTURE_TIMEOUT_S=60
# Trusted reverse proxies in front of the server (0 when it faces the internet directly).
INTROMAKER_PROXY_HOPS=1
# Rate limits are on in production; set to "off" to disable.
INTROMAKER_RATE_LIMIT=
# Sign-in protection: wrong passwords before an address is blocked, and for how many minutes.
INTROMAKER_LOGIN_TRIES=3
INTROMAKER_LOGIN_BLOCK_MIN=60
# Build-time: "off" removes the on-device Kokoro voice (its phonemizer, eSpeak NG, is GPL-3.0).
NEXT_PUBLIC_INTROMAKER_LOCAL_VOICE=
# AI generations per day paid by ANTHROPIC_API_KEY, all visitors combined.
INTROMAKER_AI_DAILY_BUDGET=200

# ── Voice-over (optional): server keys for visitors who haven't added their own ──
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── Product listings (optional): the marketplaces' own APIs, the reliable way to read a listing
# when the page blocks servers. Without them, IntroMaker reads the page, then falls back to the
# product name in the link and (Amazon) the main photo by its code.
# Amazon Product Advertising API 5 (an Amazon Associates account).
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
# eBay Browse API (an eBay developer app's client credentials).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
